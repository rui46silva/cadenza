generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Gender {
  MASCULINO
  FEMININO
}

enum Role {
  ADMIN
  MODERATOR
  PROFESSOR
  MUSICO_PROFISSIONAL
  ALUNO
}

enum InfractionType {
  SPAM
  DISCURSO_ODIO
  ASSEDIO
  DIREITOS_AUTOR
  CONTEUDO_INAPROPRIADO
  OUTRO
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  PENDING
  POST_DELETED
  AUTHOR_BANNED
  DISMISSED
}

enum PostType {
  TEXT
  VIDEO
}

enum JobType {
  ORQUESTRA
  BANDA_FILARMONICA
  JAZZ
  CORO
  OUTRO
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  role          Role      @default(ALUNO)
  verificationStatus VerificationStatus @default(APPROVED)
  verificationNote   String?
  rejectionReason    String?
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?     @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  bio           String?
  instrument    String?
  gender        Gender?
  avatarUrl     String?
  instagramHandle String?
  points        Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveAt  DateTime?
  onboardedAt   DateTime?
  isAmbassador  Boolean   @default(false)
  monthlyPoints Int       @default(0)
  monthlyPeriod String?
  lastStreakMilestone Int  @default(0)
  // Monetização. isPremium/premiumUntil = subscrição Premium ativa.
  // featuredUntil = perfil/professor em destaque pago nos diretórios.
  isPremium     Boolean   @default(false)
  premiumUntil  DateTime?
  featuredUntil DateTime?
  // Soft-delete: a conta é marcada como eliminada mas os dados ficam guardados
  // durante um período, permitindo recuperação (rollback) se a pessoa se
  // arrepender — basta voltar a iniciar sessão para reativar a conta.
  deletedAt     DateTime?
  instruments   Instrument[] @relation("UserInstruments")
  tagFollows    TagFollow[]
  createdAt     DateTime  @default(now())

  posts         Post[]
  comments      Comment[]
  postVotes     PostVote[]
  commentVotes  CommentVote[]
  notificationsReceived Notification[] @relation("NotificationsReceived")
  notificationsSent     Notification[] @relation("NotificationsSent")
  bans          Ban[]     @relation("BansReceived")
  bansIssued    Ban[]     @relation("BansIssued")
  verifiedUsers User[]    @relation("VerifiedBy")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  reportsFiled    Report[] @relation("ReportsFiled")
  reportsResolved Report[] @relation("ReportsResolved")
  newsArticles    NewsArticle[]
  jobListings     JobListing[]
  questionsDirected Post[] @relation("QuestionsDirected")

  @@index([deletedAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Ban {
  id          String         @id @default(cuid())
  user        User           @relation("BansReceived", fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  infraction  InfractionType
  reason      String?
  bannedBy    User           @relation("BansIssued", fields: [bannedById], references: [id])
  bannedById  String
  expiresAt   DateTime?
  liftedAt    DateTime?
  createdAt   DateTime       @default(now())
}

model Report {
  id           String         @id @default(cuid())
  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       String
  reporter     User           @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId   String
  reason       InfractionType
  details      String?
  status       ReportStatus   @default(PENDING)
  resolvedAt   DateTime?
  resolvedBy   User?          @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById String?
  createdAt    DateTime       @default(now())

  @@unique([postId, reporterId])
}

model Instrument {
  id    String @id @default(cuid())
  name  String @unique
  users User[] @relation("UserInstruments")
  tags  Tag[]
}

enum TagCategory {
  INSTRUMENT
  GENRE
  LEVEL
  OTHER
}

model Tag {
  id         String      @id @default(cuid())
  name       String      @unique
  category   TagCategory @default(OTHER)
  instrument Instrument? @relation(fields: [instrumentId], references: [id])
  instrumentId String?
  posts      PostTag[]
  followers  TagFollow[]
}

model TagFollow {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String
  createdAt DateTime @default(now())

  @@unique([userId, tagId])
}

model Post {
  id          String     @id @default(cuid())
  title       String
  type        PostType   @default(TEXT)
  content     String?
  videoUrl    String?
  pinned      Boolean    @default(false)
  // Post patrocinado por uma marca (monetização). Aparece com etiqueta própria
  // no topo do feed.
  sponsored   Boolean    @default(false)
  sponsorName String?
  sponsorUrl  String?
  isQuestion  Boolean    @default(false)
  feedbackRequest Boolean @default(false)
  feedbackFocus String?
  challengeId String?
  views       Int        @default(0)
  score       Int        @default(0)
  author      User       @relation(fields: [authorId], references: [id])
  authorId    String
  tags        PostTag[]
  comments    Comment[]
  votes       PostVote[]
  notifications Notification[]
  reports     Report[]
  bestAnswerId String?    @unique
  bestAnswer  Comment?   @relation("PostBestAnswer", fields: [bestAnswerId], references: [id], onDelete: SetNull)
  directedTo   User?     @relation("QuestionsDirected", fields: [directedToId], references: [id], onDelete: SetNull)
  directedToId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([createdAt])
  @@index([score])
  @@index([challengeId])
  @@index([sponsored])
}

model PostTag {
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@id([postId, tagId])
}

model Comment {
  id         String        @id @default(cuid())
  content    String
  isDeleted  Boolean       @default(false)
  post       Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  author     User          @relation(fields: [authorId], references: [id])
  authorId   String
  parent     Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId   String?
  replies    Comment[]     @relation("CommentReplies")
  votes      CommentVote[]
  notifications Notification[]
  bestAnswerOf Post?       @relation("PostBestAnswer")
  createdAt  DateTime      @default(now())
}

enum NotificationType {
  COMMENT
  REPLY
  QUESTION
  BEST_ANSWER
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  read      Boolean          @default(false)
  user      User             @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  fromUser  User             @relation("NotificationsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  fromUserId String
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  comment   Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String?          @unique
  createdAt DateTime         @default(now())
}

enum VoteValue {
  UP
  DOWN
}

model PostVote {
  id      String    @id @default(cuid())
  value   VoteValue
  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  @@unique([postId, userId])
}

model CommentVote {
  id        String    @id @default(cuid())
  value     VoteValue
  comment   Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([commentId, userId])
}

model WaitlistSignup {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  instrument  String?
  invitedAt   DateTime?
  inviteToken String?   @unique
  createdAt   DateTime  @default(now())
}

model NewsArticle {
  id              String    @id @default(cuid())
  title           String
  slug            String?   @unique
  summary         String
  // Corpo do artigo em formato blog (markdown/texto). Opcional para manter
  // compatibilidade com notícias antigas que só apontavam para uma fonte externa.
  content         String?
  // Meta-descrição usada nas tags SEO da página (Google/redes sociais).
  metaDescription String?
  url             String?
  imageUrl        String?
  source          String?
  published       Boolean   @default(true)
  publishedAt     DateTime  @default(now())
  createdBy       User      @relation(fields: [createdById], references: [id])
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([publishedAt])
}

model JobListing {
  id          String    @id @default(cuid())
  title       String
  organization String
  location    String?
  type        JobType   @default(OUTRO)
  instrument  String?
  description String
  applyUrl    String?
  contactEmail String?
  featured    Boolean   @default(false)
  expiresAt   DateTime?
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AppMeta {
  key   String @id
  value String
}
